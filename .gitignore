.build/
.DS_Store
*.swp
.worktrees/

# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.key

# Claude Code & IDE state
# Ignore .claude CONTENTS, not the directory itself — git cannot re-include
# a path whose parent directory is excluded, so `.claude/` would make the
# skills negation below a no-op.
.claude/*
# Skills are team knowledge — share them. settings.local.json (machine-
# specific) and worktrees/ (40MB of scratch checkouts) stay ignored above.
!.claude/skills/
.vscode/
.idea/
*.iml

# Node
**/node_modules/
**/dist/
**/.astro/
**/.next/
**/.turbo/

# C# / .NET
**/bin/
**/obj/
DraftRightWindows/publish/
# Self-contained publish output (incl. local test builds) — large single-file
# exes that must never be committed (GitHub rejects >100 MB).
**/publish/
**/publish-*/
DraftRightWindows/installer/Output/

# Python
**/__pycache__/
*.pyc

# Java / Gradle / Android
**/build/
**/.gradle/
**/local.properties

# Logs & runtime data
*.log
backups/
# NOTE: DraftRightLinux/data/ is NOT runtime data — it holds the desktop
# entry, AppStream metainfo and icon theme that packaging installs, and
# it was silently ignored here for months. The app's runtime state lives
# in ~/.config/draftright/.

# Built distribution artifacts — too big for GitHub (100 MB hard limit),
# and not source code. Hosted on draftright.info/downloads/ instead.
store-assets/windows/*.exe
store-assets/windows/*.msix
store-assets/windows/*.msi
.superpowers/
# Windows app — Google OAuth client_secret lives outside git. The
# GoogleOAuthConfig.cs.template is committed; the real GoogleOAuthConfig.cs
# (with the live secret) is generated/copied locally + on CI from the
# GOOGLE_OAUTH_CLIENT_SECRET env var.
DraftRightWindows/DraftRightWindows/Services/GoogleOAuthConfig.cs

# Linux app — Google OAuth client_secret, mirroring the Windows policy.
# Injected via GOOGLE_OAUTH_CLIENT_SECRET or this local file.
DraftRightLinux/**/google_client_secret

# Google OAuth client-secret JSON downloads (desktop/installed clients). These
# are stray downloads from the Cloud Console and must never be committed — the
# real secret is injected at build via GOOGLE_OAUTH_CLIENT_SECRET.
**/client_secret_*.apps.googleusercontent.com.json
DraftRightLinux/GCC/

# env-sync local canonical copies (deploy/.env.dev, deploy/.env.prod) + backups
.env.dev
.env.prod
.env.bak-*

# The user's global ignore (~/.gitignore_global) has a bare `tests` pattern,
# which matches this repo's Swift test directory and silently kept it
# untracked. Re-include it here: the macOS test target must be committed.
# Negate the DIRECTORY, not just its contents — git cannot re-include a path
# whose parent directory is excluded.
!Tests/
dist/
