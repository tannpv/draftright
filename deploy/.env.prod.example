# DraftRight prod deploy env — KEY REFERENCE ONLY (no values).
# Real values live in /opt/draftright/.env on the server and in the
# gitignored deploy/.env.prod locally. Sync them with deploy/env-sync.sh:
#   ./deploy/env-sync.sh prod pull        # fetch server -> deploy/.env.prod
#   ./deploy/env-sync.sh prod diff        # show drift (keys + value hashes)
#   ./deploy/env-sync.sh prod push        # deploy/.env.prod -> server
# The dev target uses deploy/.env.dev <-> draftright-dev/.env.dev.

ADMIN_EMAIL=
ADMIN_PASSWORD=
EMAIL_FROM=
GO_BACKEND_RAMP_PERCENT=
JWT_REFRESH_SECRET=
JWT_SECRET=
NODE_ENV=
OPENAI_API_KEY=
PAYMENT_ENABLED_METHODS=
PORT=
POSTGRES_PASSWORD=
RESEND_API_KEY=
SEPAY_API_KEY=
SEPAY_MODE=
STRIPE_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
