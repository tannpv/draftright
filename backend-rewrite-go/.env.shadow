# LOCAL shadow-gate env (gitignored). Drives docker-compose.shadow.yml + run-gate.sh
# + make-template.sh against the fully-local rig (dr-shadow-pg / dr-shadow-redis on
# the draftright-dev_default docker network). All creds here are LOCAL throwaway
# values — NOT dev/prod secrets. Tokens are minted at gate start from augment creds.

# Shared JWT secrets — a token minted by node-shadow must verify on go-shadow.
JWT_SECRET=shadowlocalsecret
JWT_REFRESH_SECRET=shadowlocalrefresh

REDIS_URL=redis://redis:6379/1

# Per-backend DSNs (in-network host alias 'postgres'). Same creds as dr-shadow-pg.
NODE_DATABASE_URL=postgres://draftright:shadowlocal@postgres:5432/draftright_shadow_node?sslmode=disable
GO_DATABASE_URL=postgres://draftright:shadowlocal@postgres:5432/draftright_shadow_go?sslmode=disable

# Maintenance DSN reachable from the HOST (run-gate.sh / shadowdiff) — local pg on 55433.
MAINT_DSN=postgres://draftright:shadowlocal@localhost:55433/postgres?sslmode=disable

# Local rig overrides for make-template.sh / run-gate.sh in-container psql.
PGCONT=dr-shadow-pg
PGUSER=draftright
SHADOW_SOURCE_DB=draftright_dev
